# Supabase Project URL - from Settings > API in Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co

# Supabase anon key - safe to expose client-side
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase service role key - server-only, never expose client-side
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI API key - from platform.openai.com
OPENAI_API_KEY=sk-...

# RapidAPI key for ExerciseDB - from rapidapi.com
RAPIDAPI_KEY=xxx

# Root domain for multi-tenant subdomain routing, without protocol or trailing slash
# Dev: leave blank to use .localhost logic automatically
# Prod: e.g. alban-rrahmani.me
ROOT_DOMAIN=
NEXT_PUBLIC_ROOT_DOMAIN=

# Vercel deployment hostname. Usually provided by Vercel automatically.
VERCEL_URL=
